# Copy to .env and fill in. Environment variables override this file.
# OpenAI-style Chat Completions provider. Fill in all three when supplied.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional OpenAI-style embeddings provider. Configure only if available.
# Use the same key/base URL as chat if your provider supports both services;
# otherwise provide separate credentials. A chat key need not grant embeddings.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
